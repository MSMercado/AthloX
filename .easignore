# Same as .gitignore, but WITHOUT the `.env` exclusion so EAS Build can
# see the EXPO_PUBLIC_* env vars at build time.
# The EXPO_PUBLIC_SUPABASE_ANON key is a public anon key (by design — it
# gets baked into the APK either way), so including .env is safe.
# The GROQ key is no longer in .env; it lives in the Supabase Edge Function.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (leave .env IN so EAS picks it up)
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
